    "description":  "",
    "dependencies":  {
                         "@types/nodemailer":  "^8.0.0",
                         "dotenv":  "^17.4.2",
                         "nodemailer":  "^8.0.7",
                         "pg":  "^8.20.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^25.6.0",
                            "@types/pg":  "^8.20.0",
                            "tsx":  "^4.21.0",
                            "typescript":  "^6.0.3"
                        }
}

{
    "name":  "content-automation-mvp",
    "version":  "1.0.0",
    "main":  "index.js",
    "directories":  {
                        "doc":  "docs"
                    },
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "generate:once":  "tsx src/scripts/generateOnce.ts",
                    "daily:pipeline":  "tsx src/scripts/runDailyPipeline.ts",
                    "enqueue:daily":  "tsx src/scripts/enqueueDailyJob.ts",
                    "worker:once":  "tsx src/scripts/workerOnce.ts",
                    "worker:loop":  "tsx src/scripts/workerLoop.ts",
                    "scheduler:loop":  "tsx src/scripts/schedulerLoop.ts",
                    "retry:failed":  "tsx src/scripts/retryFailedJobs.ts",
                    "db:migrate":  "tsx src/scripts/applyMigrations.ts",
                    "start:worker":  "node dist/scripts/workerLoop.js",
                    "start:scheduler":  "node dist/scripts/schedulerLoop.js",
                    "start:migrate":  "node dist/scripts/applyMigrations.js",
                    "plan:generate":  "tsx src/scripts/generateTopicPlan.ts",
                    "publish:once":  "tsx src/scripts/publishOnce.ts",
                    "test":  "tsx --test tests/milestone1-sql-loader.test.ts tests/sql-runner.test.ts tests/publish-message.test.ts tests/content-generator.test.ts tests/openai-quota.test.ts tests/content-plan.test.ts tests/fb-token-health.test.ts tests/post-image-generator.test.ts tests/facebook-publish.test.ts tests/topic-plan-generator.test.ts tests/daily-pipeline.test.ts tests/pipeline-jobs.test.ts tests/post-duplicate-guard.test.ts tests/server-scheduler.test.ts tests/env-config.test.ts",
                    "import:plan":  "tsx src/scripts/importContentPlanCsv.ts",
                    "schedule:install":  "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-scheduler.ps1",
                    "report:email":  "tsx src/scripts/dailyReportEmail.ts",
                    "check:fb-token":  "tsx src/scripts/checkFbToken.ts"
                },
    "keywords":  [

                 ],

# Runtime
TZ=Asia/Ho_Chi_Minh

# PostgreSQL inside docker-compose
PGHOST=db
PGPORT=5432
PGDATABASE=content_automation
PGUSER=content_user
PGPASSWORD=change_me

# Server scheduler
DAILY_PIPELINE_TIME=21:00
SCHEDULER_POLL_SECONDS=60
WORKER_POLL_SECONDS=30
RETRY_FAILED_SECONDS=3600

# OpenAI / Gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PROMPT_VERSION=v1
GEMINI_API=
GEMINI_MODEL=gemini-2.5-flash

# Cost and safety
OPENAI_DAILY_MAX_REQUESTS=20
OPENAI_DAILY_BUDGET_USD=1.0
OPENAI_EST_COST_PER_REQUEST_USD=0.02
AUTO_APPROVE=false
IMAGE_GENERATION_ENABLED=false
IMAGE_FAILURE_MODE=continue_text_only
PUBLISH_ENABLED=false
PLAN_START_DATE=2026-05-01

# Facebook Page
FB_PAGE_ID=
FB_PAGE_NAME=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v25.0
FB_APP_ID=
FB_APP_SECRET=

# Email report
REPORT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=

# Runtime
TZ=Asia/Ho_Chi_Minh
ARTIFACT_ROOT=storage/jobs
MEDIA_STORAGE_ROOT=storage/media
APP_IMAGE_LOCAL=content_automation_content_creator:local
APP_IMAGE=ghcr.io/haiduongnguyen/content-automation-generation-content_creator:latest
POSTGRES_DATA_DIR=/data/docker/content_creator/postgres_data
APP_STORAGE_DIR=/data/docker/content_creator/app_storage
VIDEO_STORAGE_DIR=/data/content_automation_videos/AI_post_facebook
REELS_ENABLED=false
REEL_RENDER_METHOD=ffmpeg_slideshow
REEL_TTS_PROVIDER=google
REEL_TARGET_DURATION_SECONDS=15
REEL_SCRIPT_GEMINI_MODEL=gemini-3.1-flash-lite
REEL_TTS_VOICE=
REEL_TTS_SPEAKING_RATE=1.15
TTS_GOOGLE_API_KEY=
GOOGLE_TTS_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
MEDIA_OWNER_UID=1000
MEDIA_OWNER_GID=1000
DB_CONTAINER_NAME=db_content_creator
MIGRATE_CONTAINER_NAME=migrate_content_creator
SCHEDULER_CONTAINER_NAME=scheduler_content_creator
WORKER_CONTAINER_NAME=worker_content_creator
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3000
ADMIN_AUTH_ENABLED=false
ADMIN_TOKEN=

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PROMPT_VERSION=v1
GEMINI_API=
# Optional: use a separate billed/old Gemini key for image generation only.
# Falls back to GEMINI_API when empty.
GEMINI_IMAGE_API=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_IMAGEN_MODEL=imagen-4.0-fast-generate-001
QWEN_API_KEY=
QWEN_MODEL=qwen-max
QWEN_IMAGE_MODEL=qwen-image
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_IMAGE_BASE_URL=https://dashscope-intl.aliyuncs.com
TEXT_PROVIDER=gemini_first
TEXT_FALLBACK_PROVIDER=openai
TEXT_OPENAI_COMPATIBLE_BASE_URL=
TEXT_OPENAI_COMPATIBLE_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
IMAGE_PROVIDER=gemini
IMAGE_FALLBACK_PROVIDER=none
IMAGE_OUTPUT_SIZE=512x512
DAILY_PIPELINE_ENABLED=false
TOPIC_MODE=auto_approve_generated
TOPIC_DUPLICATE_LOOKBACK_DAYS=60
QUARTERLY_TOPIC_PLAN_ENABLED=true
QUARTERLY_TOPIC_LEAD_DAYS=15
GEMINI_OPERATION_MAX_ATTEMPTS=2
PROVIDER_TIMEOUT_MS=180000
IMAGE_GENERATION_ENABLED=true
IMAGE_FAILURE_MODE=fail_job

# Facebook (Page)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v25.0
PUBLISH_ENABLED=false

# Workflow safety
MAX_RETRY_ATTEMPTS=3
AUTO_APPROVE=false
PLAN_START_DATE=2026-05-01

REPORT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
FB_APP_ID=
FB_APP_SECRET=

# n8n runtime env template
TZ=Asia/Ho_Chi_Minh

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=content_automation
PGUSER=postgres
PGPASSWORD=REPLACE_ME

# OpenAI
OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=gpt-5-mini

# Gemini
GEMINI_API=REPLACE_ME

# Facebook Page
FB_PAGE_ID=REPLACE_ME
FB_PAGE_ACCESS_TOKEN=REPLACE_ME
FB_GRAPH_VERSION=v25.0

# Email report
REPORT_EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
REPORT_EMAIL_FROM=REPLACE_ME
REPORT_EMAIL_TO=REPLACE_ME

# Workflow options
AUTO_APPROVE=true
PLAN_START_DATE=2026-05-01
OPENAI_DAILY_MAX_REQUESTS=20
OPENAI_DAILY_BUDGET_USD=1.0
OPENAI_EST_COST_PER_REQUEST_USD=0.02
